{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tcs-6-evidence-input/1.0",
  "title": "TCS-6 evidence bundle (Pi collector -> ingest), v1",
  "description": "Input contract for tcs-6/1.0 scoring. Mirrors EVIDENCE.md. Extra fields are allowed (ignored by scoring) so the collector can add metadata without a contract change; every field listed here is read by the engine.",
  "type": "object",
  "required": [
    "entity_id",
    "collected_at",
    "holdings",
    "obligations",
    "sources"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "description": "Registry id (^[a-z0-9][a-z0-9-]{0,63}$)."
    },
    "collected_at": {
      "type": "string",
      "description": "RFC 3339; becomes the report as_of."
    },
    "collector": {
      "type": "object"
    },
    "holdings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/holding"
      }
    },
    "obligations": {
      "$ref": "#/$defs/obligations"
    },
    "cash_uses_12m": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "flows_12m": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "recurring_treasury_inflows_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "controllable_cash_uses_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "repeatable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "governance": {
      "type": [
        "object",
        "null"
      ]
    },
    "penalties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "points",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "verification_summary": {
      "description": "Optional (Verified layer 1.3). Latest independent cross-check per field from the Pi evidence bank: verdicts, deltas and dates only, never values, upstream payloads or evidence hashes. Does not affect scoring.",
      "type": "object",
      "required": [
        "method_version",
        "as_of",
        "fields"
      ],
      "properties": {
        "method_version": {
          "type": "string"
        },
        "as_of": {
          "type": "string"
        },
        "agreement_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "field_counts": {
          "type": "object"
        },
        "fields_total": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "status",
              "sources",
              "observed_at"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "agree",
                  "partial",
                  "disagree",
                  "unavailable"
                ]
              },
              "observed_at": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "agreement"
                  ],
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "agreement": {
                      "type": "string",
                      "enum": [
                        "agree",
                        "partial",
                        "disagree",
                        "unavailable"
                      ]
                    },
                    "delta_pct": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "collector_warnings": {
      "description": "Flags the collector raised for this bundle (e.g. value_swing). Each carries the checks it ran; the bundle is still delivered as collected.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "automatic_override": {
            "type": "boolean"
          }
        }
      }
    },
    "perimeter_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "holding": {
      "type": "object",
      "required": [
        "asset_id",
        "asset_class",
        "control",
        "bucket",
        "holdings_observed_at"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "chain": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "bucket": {
          "type": "string",
          "enum": [
            "onchain",
            "offchain"
          ]
        },
        "asset_class": {
          "type": "string",
          "enum": [
            "cash_equivalent",
            "fiat_stablecoin",
            "major_crypto",
            "liquid_alt",
            "lp_position",
            "native_token",
            "locked_unverifiable"
          ]
        },
        "control": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "fair_value_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "holdings_observed_at": {
          "type": "string"
        },
        "prices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_ref",
              "usd",
              "observed_at"
            ],
            "properties": {
              "source_ref": {
                "type": "string"
              },
              "usd": {
                "type": "number"
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        },
        "haircut_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "haircut_severity": {
          "type": [
            "number",
            "null"
          ]
        },
        "realization_path_evidenced": {
          "type": "boolean"
        },
        "correlation_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "exposure_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "obligations": {
      "type": "object",
      "required": [
        "visibility"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "adequate",
            "partial",
            "unknown"
          ]
        },
        "bounded": {
          "type": "boolean"
        },
        "material_unresolved_claim": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "usd"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "debt",
                  "payable",
                  "pledge",
                  "distribution",
                  "contingency"
                ]
              },
              "usd": {
                "type": "number"
              },
              "probability": {
                "type": "number"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "id": {
                "type": "string"
              },
              "what": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "description": "Amount in unit (e.g. token units); usd is what is counted."
              },
              "unit": {
                "type": "string"
              }
            }
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "obligation_visibility": {
          "type": "object",
          "description": "Graded obligations checklist (O2). adequate needs a report at most 90 days old at as_of, every *_covered/listed/reconciled flag true and no material_conflicts; an older or undated report grades unknown. The lower of this grade and status is used.",
          "required": [
            "status",
            "report_date"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "adequate",
                "partial",
                "unknown"
              ]
            },
            "report_date": {
              "type": "string",
              "description": "YYYY-MM-DD: date the obligations evidence describes."
            },
            "publication_date": {
              "type": "string",
              "description": "YYYY-MM-DD"
            },
            "liabilities_listed": {
              "type": "boolean"
            },
            "debt_covered": {
              "type": "boolean"
            },
            "payables_covered": {
              "type": "boolean"
            },
            "streams_and_grants_covered": {
              "type": "boolean"
            },
            "legal_or_contingent_claims_covered": {
              "type": "boolean"
            },
            "scope_reconciled": {
              "type": "boolean"
            },
            "material_conflicts": {
              "type": "array",
              "description": "Each entry is a string, or an object {description, usd?, source_refs?}; an entry without usd is material."
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "governance_checked_through": {
              "type": "string",
              "description": "YYYY-MM-DD: governance records checked through this date for anything newer than the report (D21a)."
            },
            "unvalued_bounds_usd": {
              "type": "object",
              "description": "Curated upper bound in USD per missing checklist item (key = checklist field); an item without a bound is undetermined (never immaterial)."
            }
          }
        },
        "policy_id": {
          "type": "string",
          "description": "tcs6-obligations/1.0 opts this bundle in to the obligations policy (D21/D21a)."
        },
        "disclosed": {
          "type": "array",
          "description": "Commitments disclosed but not deducted (tcs6-obligations/1.0): voluntary, ex gratia, conditional, contingent, disputed, unconfirmed, own-token issuance, or already spent.",
          "items": {
            "type": "object",
            "required": [
              "what",
              "class"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "what": {
                "type": "string"
              },
              "class": {
                "type": "string",
                "enum": [
                  "voluntary",
                  "ex_gratia",
                  "conditional",
                  "contingent",
                  "disputed",
                  "unconfirmed",
                  "native_token_issuance",
                  "spent"
                ]
              },
              "amount": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "usd": {
                "type": "number"
              },
              "note": {
                "type": "string"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "source_ref",
        "title",
        "publisher",
        "url",
        "retrieved_at",
        "source_tier",
        "rights_status"
      ],
      "properties": {
        "source_ref": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string"
        },
        "observation_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_tier": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "rights_status": {
          "type": "string",
          "enum": [
            "permitted_for_derived_output",
            "licensed_for_display",
            "internal_only",
            "pending_review"
          ]
        }
      }
    }
  }
}
