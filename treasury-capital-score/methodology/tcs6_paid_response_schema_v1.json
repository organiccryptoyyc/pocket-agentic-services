{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tcs6-paid-response/1.0",
  "title": "TCS-6 Paid Crypto Treasury Report",
  "description": "Strict response contract for a payment-entitled, derived treasury analysis. Unknown financial values must be null and accompanied by a data gap; never serialize unknown as zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "analysis_status",
    "as_of",
    "currency",
    "entity",
    "payment_entitlement",
    "capital_perimeter",
    "headline",
    "hard_gates",
    "dimensions",
    "overall_score",
    "confidence",
    "data_coverage",
    "source_manifest",
    "risks",
    "data_gaps",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "tcs-6-paid-response/1.0"
    },
    "report_id": {
      "type": "string",
      "description": "Opaque report identifier; do not encode customer information."
    },
    "analysis_status": {
      "type": "string",
      "enum": [
        "ready",
        "provisional",
        "insufficient_data",
        "failed"
      ]
    },
    "as_of": {
      "type": "string",
      "description": "RFC 3339 analysis snapshot timestamp with timezone."
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "name",
        "entity_type",
        "peer_cohort",
        "registry_status"
      ],
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "dao",
            "defi_protocol",
            "foundation",
            "l1_l2_ecosystem",
            "token_operating_entity",
            "digital_asset_treasury_company",
            "other"
          ]
        },
        "peer_cohort": {
          "type": [
            "string",
            "null"
          ]
        },
        "registry_status": {
          "type": "string",
          "enum": [
            "verified",
            "partially_verified",
            "unverified"
          ]
        }
      }
    },
    "payment_entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_condition",
        "entitlement_id",
        "payment_verified_at",
        "delivery_expires_at"
      ],
      "properties": {
        "release_condition": {
          "type": "string",
          "const": "verified_payment_webhook_and_ready_validated_report"
        },
        "entitlement_id": {
          "type": "string",
          "description": "Opaque server-generated entitlement reference; no processor event payload, customer email, card data, or billing address."
        },
        "payment_verified_at": {
          "type": "string"
        },
        "delivery_expires_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capital_perimeter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_classes",
        "excluded_classes",
        "beneficial_ownership_rule",
        "known_perimeter_gaps"
      ],
      "properties": {
        "included_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "beneficial_ownership_rule": {
          "type": "string"
        },
        "known_perimeter_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gross_adjusted_treasury_usd",
        "obligations_usd",
        "net_realizable_treasury_usd",
        "capital_scale_percentile",
        "capital_scale_peer_count"
      ],
      "properties": {
        "gross_adjusted_treasury_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "obligations_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "net_realizable_treasury_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "capital_scale_percentile": {
          "type": [
            "number",
            "null"
          ]
        },
        "capital_scale_peer_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "hard_gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hard_gate"
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      },
      "description": "Server validation must require exactly one each of D1, D2, D3, D4, D5, and D6, with weights totaling 100."
    },
    "overall_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "coverage_pct",
        "decision_band",
        "status",
        "method_version"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "coverage_pct": {
          "type": "number"
        },
        "decision_band": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "strong",
            "positive",
            "watch",
            "weak",
            "reject",
            null
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "eligible",
            "provisional",
            "insufficient_data",
            "ineligible"
          ]
        },
        "method_version": {
          "type": "string",
          "const": "tcs-6/1.0"
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "label",
        "source_quality",
        "data_coverage",
        "cross_source_consistency",
        "recency_fit"
      ],
      "properties": {
        "score": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "source_quality": {
          "type": "number"
        },
        "data_coverage": {
          "type": "number"
        },
        "cross_source_consistency": {
          "type": "number"
        },
        "recency_fit": {
          "type": "number"
        }
      }
    },
    "data_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_control_value_pct",
        "offchain_disclosed_value_pct",
        "fresh_price_value_pct",
        "obligation_visibility_status"
      ],
      "properties": {
        "verified_control_value_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "offchain_disclosed_value_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "fresh_price_value_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "obligation_visibility_status": {
          "type": "string",
          "enum": [
            "adequate",
            "partial",
            "unknown"
          ]
        }
      }
    },
    "source_manifest": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/data_gap"
      }
    },
    "disclaimer": {
      "type": "string",
      "const": "This report is derived from public evidence and stated assumptions as of the reported timestamp. It is not legal, tax, accounting, or personalized investment advice, and it does not authorize or execute any transaction."
    },
    "attestation": {
      "description": "Optional (Verified layer). Signed attestation of cross-source comparisons and validation controls on this report's inputs, exactly as the collector signed it (RFC 8785 canonical payload, Ed25519), plus this service's verification verdict. Present when the evidence bundle carried an attestation or a verification summary. Never used in scoring.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_status",
        "verification_detail",
        "scoring_policy_version",
        "statement",
        "payload",
        "payload_hash",
        "signature"
      ],
      "properties": {
        "verification_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "missing",
            "stale"
          ]
        },
        "verification_detail": {
          "type": "string"
        },
        "scoring_policy_version": {
          "type": "string"
        },
        "materiality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "effect",
            "assessments"
          ],
          "properties": {
            "policy_id": {
              "type": "string"
            },
            "effect": {
              "type": "string",
              "enum": [
                "none",
                "disclose",
                "provisional",
                "insufficient_data"
              ]
            },
            "assessments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "failed_check_id",
                  "kind",
                  "subject",
                  "contract",
                  "failure_reason",
                  "position_value_usd",
                  "treasury_value_usd",
                  "treasury_share",
                  "materiality",
                  "policy_active_for_kind",
                  "score_effect"
                ],
                "properties": {
                  "failed_check_id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "contract": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "failure_reason": {
                    "type": "string"
                  },
                  "position_value_usd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "treasury_value_usd": {
                    "type": "number"
                  },
                  "treasury_share": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "materiality": {
                    "type": "string",
                    "enum": [
                      "non_material",
                      "material",
                      "critical",
                      "undetermined"
                    ]
                  },
                  "policy_active_for_kind": {
                    "type": "boolean"
                  },
                  "score_effect": {
                    "type": "string"
                  },
                  "check_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "classification_conflict: every signed exit check that passed for the position"
                  },
                  "asset_id": {
                    "type": "string"
                  },
                  "gross_observed_value_usd": {
                    "type": "number"
                  },
                  "verified_treasury_value_usd": {
                    "type": "number"
                  },
                  "liquid_value_usd": {
                    "type": "number"
                  },
                  "onchain_withdrawal_check": {
                    "type": "string",
                    "enum": [
                      "passed"
                    ]
                  },
                  "curated_classification": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "classification_status": {
                    "type": "string",
                    "enum": [
                      "conflicted"
                    ]
                  },
                  "score_treatment": {
                    "type": "string",
                    "enum": [
                      "conservative_exclusion",
                      "disclosed"
                    ]
                  },
                  "review_required": {
                    "type": "boolean"
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "capped",
                      "unchanged"
                    ]
                  },
                  "resolution_event": {
                    "type": "string"
                  },
                  "statement": {
                    "type": "string"
                  },
                  "treatment": {
                    "type": "string",
                    "enum": [
                      "flag_only",
                      "confidence_cap",
                      "evidence_based_discount",
                      "conservative_exclusion",
                      "withheld"
                    ],
                    "description": "tcs6-materiality/1.2: how the divergence changed the report"
                  },
                  "withdrawable_fraction": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "realizability: the share the chain measured as withdrawable now; null when there is no measurable basis"
                  },
                  "available_value_usd": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "realizability: the verified available value liquid capital counts"
                  },
                  "unavailable_value_usd": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "realizability: the rest of the position, reported (not deleted)"
                  },
                  "unavailable_as": {
                    "type": "string",
                    "enum": [
                      "encumbered",
                      "restricted",
                      "illiquid",
                      "unverified"
                    ]
                  },
                  "loan_health": {
                    "type": "object",
                    "description": "collateral backing a loan: the borrower account read on chain (debt, liquidation threshold, encumbered value, block)"
                  },
                  "evidence_hashes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "large_divergence": {
                    "type": "boolean",
                    "description": "the unavailable or unverified part > $1M or > 10% of counted treasury, or the position >= 25%: review required, never ready"
                  },
                  "observed_value_usd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "reported_value_usd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "reported_as_of": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "gap_usd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "price_spread_pct": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "price_readings": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            },
            "review_required": {
              "type": "boolean",
              "description": "present (true) when the report carries a classification conflict (1.1) or a large divergence or withheld score (1.2)"
            }
          }
        },
        "statement": {
          "type": "string"
        },
        "payload": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "type",
            "schema_version",
            "method_version",
            "attestation_id",
            "subject",
            "window",
            "counters",
            "checks_total",
            "truncated",
            "independence_classes",
            "conflict_policy",
            "score_boundary",
            "checks",
            "review_items",
            "review_required",
            "evidence_manifest",
            "evidence_manifest_hash",
            "statement"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "tcs6-input-attestation"
            },
            "schema_version": {
              "type": "string",
              "enum": [
                "tcs6-attestation/1.1",
                "tcs6-attestation/1.2"
              ]
            },
            "method_version": {
              "type": "string"
            },
            "attestation_id": {
              "type": "string"
            },
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "service",
                "entity_id",
                "bundle_collected_at"
              ],
              "properties": {
                "service": {
                  "type": "string"
                },
                "entity_id": {
                  "type": "string"
                },
                "bundle_collected_at": {
                  "type": "string"
                }
              }
            },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "first",
                "last"
              ],
              "properties": {
                "first": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "last": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "counters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "comparisons",
                "controls"
              ],
              "properties": {
                "comparisons": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "attempted",
                    "passed",
                    "conflicted",
                    "unavailable",
                    "not_applicable",
                    "completed",
                    "requiring_review"
                  ],
                  "properties": {
                    "attempted": {
                      "type": "integer"
                    },
                    "passed": {
                      "type": "integer"
                    },
                    "conflicted": {
                      "type": "integer"
                    },
                    "unavailable": {
                      "type": "integer"
                    },
                    "not_applicable": {
                      "type": "integer"
                    },
                    "completed": {
                      "type": "integer"
                    },
                    "requiring_review": {
                      "type": "integer"
                    }
                  }
                },
                "controls": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "attempted",
                    "passed",
                    "failed",
                    "unavailable",
                    "not_applicable",
                    "completed",
                    "requiring_review"
                  ],
                  "properties": {
                    "attempted": {
                      "type": "integer"
                    },
                    "passed": {
                      "type": "integer"
                    },
                    "failed": {
                      "type": "integer"
                    },
                    "unavailable": {
                      "type": "integer"
                    },
                    "not_applicable": {
                      "type": "integer"
                    },
                    "completed": {
                      "type": "integer"
                    },
                    "requiring_review": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "checks_total": {
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            },
            "independence_classes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "independent_economic_source",
                "partially_independent",
                "transport_corroboration",
                "contract_identity_control",
                "naming_control",
                "realizability_control"
              ],
              "properties": {
                "independent_economic_source": {
                  "type": "string"
                },
                "partially_independent": {
                  "type": "string"
                },
                "transport_corroboration": {
                  "type": "string"
                },
                "contract_identity_control": {
                  "type": "string"
                },
                "naming_control": {
                  "type": "string"
                },
                "realizability_control": {
                  "type": "string"
                }
              }
            },
            "conflict_policy": {
              "type": "string"
            },
            "score_boundary": {
              "type": "string"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "check_id",
                  "group",
                  "kind",
                  "independence",
                  "field",
                  "label",
                  "source",
                  "source_ref",
                  "chain_id",
                  "block_number",
                  "block_hash",
                  "observed_at",
                  "retrieved_at",
                  "rule",
                  "status",
                  "our_value",
                  "other_value",
                  "other_value_disclosed",
                  "delta_pct",
                  "measure",
                  "evidence_hash"
                ],
                "properties": {
                  "check_id": {
                    "type": "string"
                  },
                  "group": {
                    "type": "string",
                    "enum": [
                      "comparison",
                      "control"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "price_comparison",
                      "disclosure_reconciliation",
                      "retrieval_control",
                      "contract_identity_control",
                      "realizability_control",
                      "naming_control"
                    ]
                  },
                  "independence": {
                    "type": "string",
                    "enum": [
                      "independent_economic_source",
                      "partially_independent",
                      "transport_corroboration",
                      "contract_identity_control",
                      "naming_control",
                      "realizability_control"
                    ]
                  },
                  "field": {
                    "type": "string"
                  },
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "source_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "chain_id": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "block_number": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "block_hash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "observed_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "retrieved_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rule": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "passed",
                      "failed",
                      "conflicted",
                      "unavailable",
                      "not_applicable"
                    ]
                  },
                  "our_value": {
                    "description": "Our observed value, as recorded (number, string, object or null)."
                  },
                  "other_value": {
                    "description": "The other source's reading where its terms allow disclosure (on-chain, public data); null for vendor data."
                  },
                  "other_value_disclosed": {
                    "type": "boolean"
                  },
                  "delta_pct": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "measure": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "evidence_hash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "review_items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "conflicted_check_ids",
                "failed_check_ids",
                "unavailable_check_ids"
              ],
              "properties": {
                "conflicted_check_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "failed_check_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "unavailable_check_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "conflicted_checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "check_id",
                      "kind",
                      "subject",
                      "chain_id",
                      "contract",
                      "source",
                      "result",
                      "failure_reason",
                      "failure_detail",
                      "materiality",
                      "review_required"
                    ],
                    "properties": {
                      "check_id": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "subject": {
                        "type": "string"
                      },
                      "chain_id": {
                        "type": [
                          "integer",
                          "string",
                          "null"
                        ]
                      },
                      "contract": {
                        "type": [
                          "string",
                          "null"
