{
  "openapi": "3.1.0",
  "info": {
    "title": "Capital Integrity Dossier",
    "version": "1.7.0",
    "description": "Pocket Network service `capital-integrity-dossier`. A disclosed multi-call dossier on one protocol scored by TCS-6 (`treasury-capital-score`). A full dossier takes up to 7 calls (up to $0.035 at the portal's $0.005 per call): POST /v1/dossier/plan first (1 call; it states calls_required and the estimated total before you commit), then POST /v1/dossier/section once per available section, in any order. You pay only for the calls you make and can stop after any section; every response carries calls_used, calls_remaining and the remaining estimate. A dossier_id pins one TCS-6 snapshot (a report together with the exact evidence bundle it was scored from) for 24 hours. All inputs travel in a JSON POST body; every response is a JSON object. Paid per relay via a staked Pocket application; there is no checkout. Charts are JSON series for the caller to render. Research, not investment advice. Since 1.6.0, POST /v1/dossier/availability answers in one call ($0.005) how much of the verified treasury could be used now, split into buckets that add up to the observed total. Since 1.7.0, plan, section and availability responses also carry `verified`: the same who / when / what / which-evidence block every service in this family returns (pocket-agentic-envelope/1), so results can be joined across services by subject id."
  },
  "paths": {
    "/v1/dossier/plan": {
      "post": {
        "operationId": "plan",
        "summary": "Start a dossier: pin the latest TCS-6 snapshot, list the sections, state the calls and price",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["entity_id"],
                "additionalProperties": false,
                "properties": { "entity_id": { "type": "string", "examples": ["inverse-finance"], "description": "Id from /v1/dossier/entities." } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "The plan.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Plan" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/dossier/section": {
      "post": {
        "operationId": "section",
        "summary": "One section of a planned dossier",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["dossier_id", "section"],
                "additionalProperties": false,
                "properties": {
                  "dossier_id": { "type": "string", "pattern": "^dos_[0-9a-f]{24}$" },
                  "section": { "$ref": "#/components/schemas/SectionName" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "The section. available false (with a reason and data null) when the pinned snapshot cannot support it.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Section" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/dossier/entities": {
      "post": {
        "operationId": "entities",
        "summary": "The protocols a dossier can cover",
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "200": {
            "description": "Listing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["schema_version", "entities", "note"],
                  "properties": {
                    "schema_version": { "const": "capital-integrity-dossier/1.0" },
                    "entities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["entity_id"],
                        "properties": {
                          "entity_id": { "type": "string" },
                          "name": { "type": "string" },
                          "as_of": { "type": "string", "format": "date-time" },
                          "overall_score": { "type": ["number", "null"] },
                          "status": { "type": "string" }
                        }
                      }
                    },
                    "note": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/dossier/availability": {"post": {"operationId": "availability", "summary": "One call: how much of a protocol's verified treasury could be used now, and why not the rest", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["entity_id"], "additionalProperties": false, "properties": {"entity_id": {"type": "string", "examples": ["aave"], "description": "Id from /v1/dossier/entities."}}}}}}, "responses": {"200": {"description": "Availability split.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Availability"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/v1/version": {
      "get": { "operationId": "version", "responses": { "200": { "description": "{\"service\":\"capital-integrity-dossier\",\"version\":\"1.2.1\"}", "content": { "application/json": {} } } } }
    },
    "/v1/health": {
      "get": { "operationId": "health", "responses": { "200": { "description": "{\"status\":\"ok\",\"entities\":22,\"last_snapshot_refresh\":\"...\"}", "content": { "application/json": {} } } } }
    }
  },
  "components": {
    "schemas": {
      "Verified": {"description": "Since 1.7.0. The shared pocket-agentic-envelope/1 block (docs/envelope in the repo): who the response is about (subject protocol:tcs6:<entity_id>, with its treasury wallets as CAIP-10 links), when it was true (as_of), what was concluded (assessment: the TCS-6 judgement on plan; not_scored on section and availability, which return facts), the sources behind it (evidence, at most 50; internal_only sources are never included), what is missing (gaps) and the attestation it rests on. Every value is copied from the same TCS-6 snapshot as the rest of the response; the dossier's own fields stay authoritative.", "type": "object", "additionalProperties": false, "required": ["schema", "service", "service_version", "route", "subject", "as_of", "generated_at", "assessment", "evidence", "gaps", "attestation_ref"], "properties": {"schema": {"const": "pocket-agentic-envelope/1"}, "service": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,41}$", "description": "The Pocket service ID that produced the response."}, "service_version": {"type": "string", "minLength": 1}, "route": {"type": "string", "pattern": "^/v[0-9]+/[a-z0-9/_-]+$"}, "subject": {"$ref": "#/components/schemas/Verified_subject"}, "as_of": {"$ref": "#/components/schemas/Verified_timestamp", "description": "When the facts in the response were true (the newest evidence the result rests on), not when the response was produced."}, "generated_at": {"$ref": "#/components/schemas/Verified_timestamp", "description": "When this response was produced (or read from cache)."}, "assessment": {"$ref": "#/components/schemas/Verified_assessment"}, "evidence": {"type": "array", "maxItems": 50, "items": {"$ref": "#/components/schemas/Verified_evidence"}, "description": "The sources the result rests on, at most 50. Use evidence_more for the full list."}, "evidence_more": {"type": ["object", "null"], "additionalProperties": false, "required": ["route", "count"], "properties": {"route": {"type": "string", "pattern": "^/v[0-9]+/[a-z0-9/_-]+$"}, "count": {"type": "integer", "minimum": 0}, "note": {"type": "string"}}, "description": "Where the full evidence lives when it is longer than `evidence` or too large to inline (for example brand-protection /v1/brand/evidence)."}, "gaps": {"type": "array", "items": {"$ref": "#/components/schemas/Verified_gap"}, "description": "What is missing or unverified. An empty list means none was detected, never that none can exist."}, "attestation_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/components/schemas/Verified_attestation_ref"}]}}},
      "Verified_timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2}))?$", "description": "ISO 8601 date or UTC date-time. A bare date means the source publishes daily or coarser."},
      "Verified_subject_id": {"type": "string", "pattern": "^(protocol|company|drug|brand|domain|wallet|market|topic|jurisdiction|network_actor):[a-z0-9][a-z0-9._-]*:[^\\s]+$", "description": "<kind>:<namespace>:<value>. Lowercase kind and namespace; the value keeps the case its namespace defines (CAIP-10 addresses, SEC CIKs with leading zeros)."},
      "Verified_subject": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "name", "identifiers"], "properties": {"kind": {"type": "string", "enum": ["protocol", "company", "drug", "brand", "domain", "wallet", "market", "topic", "jurisdiction", "network_actor"]}, "id": {"$ref": "#/components/schemas/Verified_subject_id"}, "name": {"type": ["string", "null"]}, "identifiers": {"type": "object", "description": "Other names the same subject is known by. Keys are namespaces; values are strings or arrays of strings.", "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "maxItems": 50}]}}, "links": {"type": "array", "maxItems": 50, "items": {"$ref": "#/components/schemas/Verified_link"}, "description": "Related subjects another service in this family can answer about (a protocol's treasury wallets, a brand's official domains)."}}},
      "Verified_link": {"type": "object", "additionalProperties": false, "required": ["rel", "id"], "properties": {"rel": {"type": "string", "enum": ["treasury_wallet", "official_domain", "issuer", "manufacturer", "parent", "counterparty", "lookalike_of", "same_as"]}, "id": {"$ref": "#/components/schemas/Verified_subject_id"}, "service": {"type": ["string", "null"], "description": "A service ID that answers about the linked subject, when one does."}}},
      "Verified_assessment": {"type": "object", "additionalProperties": false, "required": ["status", "native_status", "score", "scale", "label", "confidence", "coverage_pct"], "properties": {"status": {"type": "string", "enum": ["ok", "provisional", "insufficient_data", "ineligible", "not_scored"], "description": "Normalized across services. not_scored = the route returns facts, not a judgement (an evidence lookup, a list)."}, "native_status": {"type": ["string", "null"], "description": "The service's own status value, unchanged."}, "score": {"type": ["number", "null"]}, "scale": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["min", "max", "higher_is"], "properties": {"min": {"type": "number"}, "max": {"type": "number"}, "higher_is": {"type": "string", "enum": ["better", "riskier"]}}}]}, "label": {"type": ["string", "null"]}, "confidence": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["score", "label"], "properties": {"score": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "label": {"type": ["string", "null"], "enum": ["high", "medium", "low", null]}}}]}, "coverage_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}}},
      "Verified_evidence": {"type": "object", "additionalProperties": false, "required": ["source_ref", "title", "publisher", "url", "retrieved_at", "observation_time", "source_tier", "rights_status"], "description": "Same fields as the TCS-6 source manifest (tcs6_paid_response_schema_v1 $defs/source), with null allowed where another service cannot know the value.", "properties": {"source_ref": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "publisher": {"type": "string"}, "url": {"type": ["string", "null"], "pattern": "^https?://"}, "retrieved_at": {"oneOf": [{"type": "null"}, {"$ref": "#/components/schemas/Verified_timestamp"}]}, "observation_time": {"oneOf": [{"type": "null"}, {"$ref": "#/components/schemas/Verified_timestamp"}]}, "source_tier": {"type": ["integer", "null"], "enum": [1, 2, 3, 4, 5, null], "description": "TCS-6 tiers: 1 = primary on-chain or regulator record ... 5 = unverified secondary. null = not yet graded."}, "rights_status": {"type": "string", "enum": ["permitted_for_derived_output", "licensed_for_display", "internal_only", "pending_review"]}}},
      "Verified_gap": {"type": "object", "additionalProperties": false, "required": ["field", "reason", "impact"], "description": "Same fields as TCS-6 $defs/data_gap; remediation optional.", "properties": {"field": {"type": "string"}, "reason": {"type": "string"}, "impact": {"type": "string"}, "remediation": {"type": "string"}}},
      "Verified_attestation_ref": {"type": "object", "additionalProperties": false, "required": ["attestation_id", "key_id", "payload_hash", "verification_status"], "description": "Points at a signed attestation (capital-integrity-dossier AttestationRef, TCS-6 attestation). The signature itself stays in the service's own field.", "properties": {"attestation_id": {"type": ["string", "null"]}, "key_id": {"type": ["string", "null"]}, "payload_hash": {"type": ["string", "null"]}, "verification_status": {"type": "string", "enum": ["valid", "invalid", "missing", "stale"]}}},
      "AvailabilityPosition": {"type": "object", "required": ["value_usd", "reason"], "properties": {"symbol": {"type": ["string", "null"]}, "chain": {"type": ["string", "null"]}, "wallet": {"type": ["string", "null"]}, "asset_class": {"type": "string"}, "value_usd": {"type": "number"}, "reason": {"type": "string"}, "confirmed_by_check": {"type": "boolean"}, "exit_check": {"type": "string"}, "block_number": {"type": ["integer", "null"]}, "evidence_hash": {"type": ["string", "null"]}, "cause": {"type": "string"}, "backs_loans": {"type": "array", "items": {"type": "object"}}}},
      "AvailabilityBucket": {"type": "object", "required": ["usd", "share_pct", "meaning", "positions_total", "positions"], "properties": {"usd": {"type": "number"}, "share_pct": {"type": ["number", "null"]}, "meaning": {"type": "string"}, "positions_total": {"type": "integer"}, "positions": {"type": "array", "maxItems": 25, "items": {"$ref": "#/components/schemas/AvailabilityPosition"}}, "other_positions": {"type": "object", "properties": {"count": {"type": "integer"}, "usd": {"type": "number"}}}}},
      "Availability": {"type": "object", "required": ["schema_version", "method", "entity", "as_of", "snapshot_report_id", "summary", "reported", "buckets", "not_valued", "rules", "cost", "attestation_ref", "disclaimer"], "properties": {"schema_version": {"const": "capital-integrity-dossier/1.0"}, "method": {"const": "tcs6-availability/1.0"}, "entity": {"$ref": "#/components/schemas/Entity"}, "as_of": {"type": "string", "format": "date-time"}, "snapshot_report_id": {"type": "string"}, "summary": {"type": "object", "required": ["observed_usd", "available_now_usd", "available_share_pct", "available_confirmed_by_exit_check_usd", "own_token_usd", "encumbered_usd", "restricted_usd", "illiquid_now_usd", "unresolved_usd", "reported_usd", "statement"], "properties": {"observed_usd": {"type": "number"}, "available_now_usd": {"type": "number"}, "available_share_pct": {"type": ["number", "null"]}, "available_confirmed_by_exit_check_usd": {"type": "number"}, "own_token_usd": {"type": "number"}, "encumbered_usd": {"type": "number"}, "restricted_usd": {"type": "number"}, "illiquid_now_usd": {"type": "number"}, "unresolved_usd": {"type": "number"}, "reported_usd": {"type": ["number", "null"]}, "statement": {"type": "string"}}, "description": "The six buckets add up to observed_usd. available_share_pct = available_now_usd / observed_usd; a share, not a score."}, "reported": {"type": "object", "required": ["usd"], "properties": {"usd": {"type": ["number", "null"]}, "reason": {"type": "string"}, "as_of": {"type": ["string", "null"]}, "age_days": {"type": ["integer", "null"]}, "stale_usd": {"type": "number"}, "scope_status": {"type": ["string", "null"]}, "source_refs": {"type": "array", "items": {"type": "string"}}}, "description": "The protocol's own cited USD total, null (with the reason) when there is none or it is older than 90 days."}, "buckets": {"type": "object", "required": ["available_now", "own_token", "encumbered", "restricted", "illiquid_now", "unresolved"], "properties": {"available_now": {"$ref": "#/components/schemas/AvailabilityBucket"}, "own_token": {"$ref": "#/components/schemas/AvailabilityBucket"}, "encumbered": {"$ref": "#/components/schemas/AvailabilityBucket"}, "restricted": {"$ref": "#/components/schemas/AvailabilityBucket"}, "illiquid_now": {"$ref": "#/components/schemas/AvailabilityBucket"}, "unresolved": {"$ref": "#/components/schemas/AvailabilityBucket"}}}, "not_valued": {"type": "array", "items": {"type": "string"}}, "rules": {"type": "object"}, "cost": {"type": "object", "required": ["calls", "price_per_call_usd", "total_usd", "basis"], "properties": {"calls": {"type": "integer"}, "price_per_call_usd": {"type": "number"}, "total_usd": {"type": "number"}, "basis": {"type": "string"}, "deeper": {"type": "string"}}}, "attestation_ref": {"$ref": "#/components/schemas/AttestationRef"}, "disclaimer": {"type": "string"}, "verified": {"$ref": "#/components/schemas/Verified"}}},
      "SectionName": { "enum": ["holdings_map", "authority_graph", "obligations_register", "exit_liquidity", "reconciliation", "unresolved_items"] },
      "Estimate": {
        "type": "object",
        "required": ["price_per_call_usd", "remaining_usd", "basis"],
        "properties": {
          "price_per_call_usd": { "type": "number" },
          "total_usd": { "type": "number" },
          "remaining_usd": { "type": "number" },
          "basis": { "type": "string" }
        }
      },
      "AttestationRef": {
        "type": "object",
        "required": ["attestation_id", "key_id", "evidence_manifest_hash", "verification_status"],
        "properties": {
          "attestation_id": { "type": ["string", "null"] },
          "key_id": { "type": ["string", "null"] },
          "evidence_manifest_hash": { "type": ["string", "null"] },
          "verification_status": { "type": "string" }
        }
      },
      "Entity": { "type": "object", "required": ["entity_id"], "properties": { "entity_id": { "type": "string" }, "name": { "type": "string" } } },
      "Chart": {
        "type": "object",
        "required": ["type", "title", "series"],
        "properties": {
          "type": { "const": "bar" },
          "title": { "type": "string" },
          "series": { "type": "array", "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "number" } } } }
        }
      },
      "Plan": {
        "type": "object",
        "required": ["schema_version", "dossier_id", "entity", "as_of", "snapshot_report_id", "valid_until", "headline", "sections", "calls_required", "calls_used", "calls_remaining", "estimate", "notice", "attestation_ref", "disclaimer"],
        "properties": {
          "schema_version": { "const": "capital-integrity-dossier/1.0" },
          "dossier_id": { "type": "string", "pattern": "^dos_[0-9a-f]{24}$" },
          "entity": { "$ref": "#/components/schemas/Entity" },
          "as_of": { "type": "string", "format": "date-time", "description": "When the TCS-6 collector observed this snapshot." },
          "snapshot_report_id": { "type": "string" },
          "valid_until": { "type": "string", "format": "date-time" },
          "headline": { "type": "object", "properties": { "overall_score": { "type": ["number", "null"] }, "status": { "type": "string" } } },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["section", "description", "available"],
              "properties": { "section": { "$ref": "#/components/schemas/SectionName" }, "description": { "type": "string" }, "available": { "type": "boolean" }, "reason": { "type": "string" } }
            }
          },
          "calls_required": { "type": "integer", "minimum": 1, "maximum": 7, "description": "This plan call plus one call per available section." },
          "calls_used": { "const": 1 },
          "calls_remaining": { "type": "integer", "minimum": 0 },
          "estimate": { "$ref": "#/components/schemas/Estimate" },
          "notice": { "type": "string", "description": "Buyer notice: the multi-call design, the number of calls and the estimated total." },
          "next": { "type": "string" },
          "attestation_ref": { "$ref": "#/components/schemas/AttestationRef" },
          "disclaimer": { "type": "string" },
          "verified": { "$ref": "#/components/schemas/Verified" }
        }
      },
      "Section": {
        "type": "object",
        "required": ["schema_version", "dossier_id", "entity", "section", "available", "as_of", "snapshot_report_id", "calls_used", "calls_remaining", "estimate", "attestation_ref", "data", "disclaimer"],
        "properties": {
          "schema_version": { "const": "capital-integrity-dossier/1.0" },
          "dossier_id": { "type": "string" },
          "entity": { "$ref": "#/components/schemas/Entity" },
          "section": { "$ref": "#/components/schemas/SectionName" },
          "available": { "type": "boolean" },
          "reason": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" },
          "snapshot_report_id": { "type": "string" },
          "calls_used": { "type": "integer", "minimum": 2, "description": "Every call made on this dossier, the plan call included." },
          "calls_remaining": { "type": "integer", "minimum": 0, "description": "Available sections not yet returned." },
          "estimate": { "$ref": "#/components/schemas/Estimate" },
          "attestation_ref": { "$ref": "#/components/schemas/AttestationRef" },
          "data": { "type": ["object", "null"], "description": "Section content; see README.md for each section's fields." },
          "chart": { "$ref": "#/components/schemas/Chart" },
          "note": { "type": "string" },
          "disclaimer": { "type": "string" },
          "verified": { "$ref": "#/components/schemas/Verified" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed body, an unknown entity_id or section, or a dossier_id that is unknown or older than 24 hours.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["error"],
              "properties": { "error": { "type": "object", "properties": { "code": { "enum": ["invalid_input", "unknown_entity", "unknown_dossier", "not_found"] }, "message": { "type": "string" } } } }
            }
          }
        }
      }
    }
  }
}
