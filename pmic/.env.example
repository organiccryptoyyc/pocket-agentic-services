# Copy to .env (gitignored) on the Pi / Umbrel box. Everything is optional except the SEC
# User-Agent, without which SEC series are skipped with a missing_key alert.

# SEC fair access: "<your name or org> <contact email>"
PMIC_SEC_USER_AGENT=

# Free keys. Without FRED_API_KEY the collector uses FRED's public CSV download; without
# BLS_API_KEY it uses BLS v1 (25 queries/day is enough for the default catalog); BEA has no
# keyless mode, so BEA series wait for BEA_API_KEY; openFDA works keyless at 1,000 requests/day.
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
OPENFDA_API_KEY=
# Optional free keys for batch 2: FEC from api.data.gov (DEMO_KEY is used without it), Senate LDA.
FEC_API_KEY=
LDA_API_KEY=
# Batch 3: NVD and CDC keys are optional and only raise rate limits.
NVD_API_KEY=
CDC_APP_TOKEN=
# Contact for the Wikimedia User-Agent (defaults to PMIC_SEC_USER_AGENT).
PMIC_CONTACT=

# Query API bearer token (generate with: openssl rand -hex 32). Leave empty only on a private LAN.
PMIC_API_TOKEN=

# Push to the hub on the Pocket server after every pass (same token as the hub's PMIC_INGEST_TOKEN).
PMIC_PUSH_URL=
PMIC_PUSH_TOKEN=

# Minutes between collector passes; each pass fetches only series that are due.
PMIC_LOOP_MINUTES=15
