                "type": [
                  "string",
                  "null"
                ]
              },
              "p_cut": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p_hold": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p_hike": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "implied_change_bp": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Probability-weighted change in basis points (50+ counted as 50)."
              },
              "most_likely": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "volume_24h_usd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stale": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lean": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "cut",
                  "hold",
                  "hike",
                  null
                ],
                "description": "cut, hold or hike; null when that view has no reading."
              }
            }
          },
          "bond_market": {
            "type": "object",
            "properties": {
              "policy_rate_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "treasury_2y_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "spread_2y_minus_policy_bp": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "lean": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "cut",
                  "hold",
                  "hike",
                  null
                ],
                "description": "cut, hold or hike; null when that view has no reading."
              },
              "horizon": {
                "type": "string"
              }
            }
          },
          "data": {
            "type": "object",
            "properties": {
              "score": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lean": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "cut",
