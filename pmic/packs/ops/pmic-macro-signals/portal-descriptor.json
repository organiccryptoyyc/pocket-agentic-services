{
  "serviceId": "pmic-macro-signals",
  "displayName": "PMIC Macro and Markets Signals",
  "description": "Scored US and global macro briefs from official public data (FRED, BLS, BEA, EIA, Census, TreasuryDirect, ECB, FDIC, CFPB, World Bank, IMF, OECD), an economic release calendar (BLS, BEA), plus Pocket Network health. Each brief is a 0-100 score with label, trend versus the horizon, the inputs that drive it, risk flags, confidence and a citation for every input. Includes a CPI inflation calculator. The fed-consensus brief sets Polymarket's odds for the next FOMC meeting beside the bond market (2-year yield vs fed funds) and the inflation and jobs data, and says whether they agree. POST /v1/brief with a small JSON body for one scored, cited brief; POST /v1/overview for all of them at once. Results vary as public data updates (5-minute cache). Research signal, not investment advice. Pay per request in USDC; no account, no API key.",
  "category": "finance",
  "protocols": [
    "rest"
  ],
  "inputSchema": {
    "type": "object",
    "description": "Body for POST /v1/brief (other routes take similar small bodies).",
    "properties": {
      "vertical": {
        "type": "string",
        "enum": [
          "macro-regime",
          "inflation",
          "labor",
          "rates",
          "fed-consensus",
          "credit-stress",
          "commodities",
          "global-compare",
          "housing",
          "consumer",
          "country-risk",
          "health-systems",
          "education",
          "yield-curve",
          "bank-health",
          "global-rates-fx",
          "treasury-demand",
          "energy-supply",
          "trade-flows",
          "business-formation",
          "pokt-network-health",
          "supply-chain-pressure",
          "food-inflation",
          "state-labor",
          "imf-outlook",
          "economic-calendar",
          "leading-indicators"
        ],
        "description": "Which brief. POST /v1/verticals describes each."
      },
      "horizon": {
        "type": "string",
        "enum": [
          "7d",
          "30d",
          "90d",
          "365d"
        ],
        "description": "Comparison window; default 90d."
      }
    },
    "required": [
      "vertical"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "service": {
        "type": "string"
      },
      "pack_version": {
        "type": "string"
      },
      "vertical": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "question": {
        "type": "string"
      },
      "entity": {
        "description": "The company ({entity_id, name, ...}) on company briefs; absent otherwise."
      },
      "horizon": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "insufficient_data"
        ]
      },
      "score": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 100,
        "description": "Integer 0-100, or null when status is insufficient_data."
      },
      "label": {
        "type": [
          "string",
          "null"
        ],
        "description": "The vertical's label for the score, or null with no score."
      },
      "trend": {
        "type": "string"
      },
      "trend_basis": {
        "type": [
          "string",
          "null"
        ],
        "description": "score_history, input_trends, or null when there is no trend."
      },
      "summary": {
        "type": "string"
      },
      "drivers": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "risk_flags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "confidence": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "watch": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "recent_events": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "citations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      },
      "attestation": {
        "type": "object",
        "description": "Signed input attestations for the series this answer cites (Verified layer). Each series has a verification status (valid, stale, invalid, or missing when no cross-check is run for it) and, unless invalid, the envelope exactly as the collector signed it: Ed25519 over an RFC 8785 payload, public key in config/attestation_keys.json. Attestation only: it never changes a score, label or value.",
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "summary": {
            "type": "object",
            "properties": {
              "series": {
                "type": "integer"
              },
              "valid": {
                "type": "integer"
              },
              "stale": {
                "type": "integer"
              },
              "invalid": {
                "type": "integer"
              },
              "missing": {
                "type": "integer"
              }
            }
          },
          "statement": {
            "type": "string"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "series_id": {
                  "type": "string"
                },
                "verification_status": {
                  "type": "string",
                  "enum": [
                    "valid",
                    "stale",
                    "invalid",
                    "missing"
                  ]
                },
                "verification_detail": {
                  "type": "string"
                },
                "envelope": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "fed_consensus": {
        "type": "object",
        "description": "fed-consensus brief only: three independent views of the Fed's next move side by side.",
        "properties": {
          "prediction_market": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "meeting": {
                "type": [
                  "string",
                  "null"
                ]
              },
