{
  "openapi": "3.1.0",
  "info": {
    "title": "Wallet and DeFi Intelligence API",
    "version": "1.0.0",
    "description": "wallet-defi-intel on Pocket Network. Every response is a JSON object. All inputs arrive in the POST body. Errors are 4xx with a JSON {error:{code,message}} body, never 5xx or HTML. Every field is fetched live from public Blockscout explorer instances (EVM chains) or DefiLlama's public API at request time."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/v1/version": { "get": { "summary": "Service identity", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object" } } } } } } },
    "/v1/health": { "get": { "summary": "Readiness", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object" } } } } } } },
    "/v1/wallet-balance": { "post": { "summary": "Native + priced token balances for an EVM wallet", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["chain", "address"], "properties": { "chain": { "type": "string", "enum": ["eth", "base", "arbitrum", "polygon"] }, "address": { "type": "string" } } } } } }, "responses": { "200": { "description": "Success" }, "404": { "$ref": "#/components/responses/NotFound" }, "422": { "$ref": "#/components/responses/ClientError" } } } },
    "/v1/wallet-risk": { "post": { "summary": "0-100 risk score for an EVM wallet (higher = riskier)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["chain", "address"], "properties": { "chain": { "type": "string" }, "address": { "type": "string" } } } } } }, "responses": { "200": { "description": "Success" }, "404": { "$ref": "#/components/responses/NotFound" }, "422": { "$ref": "#/components/responses/ClientError" } } } },
    "/v1/smart-money": { "post": { "summary": "0-100 heuristic 'established/clean wallet' score", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["chain", "address"], "properties": { "chain": { "type": "string" }, "address": { "type": "string" } } } } } }, "responses": { "200": { "description": "Success" }, "404": { "$ref": "#/components/responses/NotFound" }, "422": { "$ref": "#/components/responses/ClientError" } } } },
    "/v1/prospect-enrichment": { "post": { "summary": "Combined balance + risk + smart-money profile in one call", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["chain", "address"], "properties": { "chain": { "type": "string" }, "address": { "type": "string" } } } } } }, "responses": { "200": { "description": "Success" }, "404": { "$ref": "#/components/responses/NotFound" }, "422": { "$ref": "#/components/responses/ClientError" } } } },
    "/v1/precheck": { "post": { "summary": "Pre-transaction gate: wallet risk + target protocol's TVL trend and hack history", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["chain", "address", "protocol"], "properties": { "chain": { "type": "string" }, "address": { "type": "string" }, "protocol": { "type": "string", "example": "aave" } } } } } }, "responses": { "200": { "description": "Success", "content": { "application/json": { "schema": { "type": "object", "properties": { "recommendation": { "type": "string", "enum": ["proceed", "proceed_with_caution", "avoid"] } } } } } }, "404": { "$ref": "#/components/responses/NotFound" }, "422": { "$ref": "#/components/responses/ClientError" } } } },
    "/v1/yields": { "post": { "summary": "Top yield opportunities ranked by live APY (DefiLlama)", "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object", "properties": { "chain": { "type": "string" }, "stablecoin_only": { "type": "boolean" }, "min_tvl_usd": { "type": "integer" }, "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } } } } } }, "responses": { "200": { "description": "Success" }, "422": { "$ref": "#/components/responses/ClientError" } } } },
    "/v1/protocol-health": { "post": { "summary": "TVL trend, chains, hacks for a DefiLlama protocol slug", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["protocol"], "properties": { "protocol": { "type": "string", "example": "aave" } } } } } }, "responses": { "200": { "description": "Success" }, "404": { "$ref": "#/components/responses/NotFound" }, "422": { "$ref": "#/components/responses/ClientError" } } } },
    "/v1/depeg-check": { "post": { "summary": "Live stablecoin price vs. peg", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["symbol"], "properties": { "symbol": { "type": "string", "example": "USDT" } } } } } }, "responses": { "200": { "description": "Success" }, "404": { "$ref": "#/components/responses/NotFound" }, "422": { "$ref": "#/components/responses/ClientError" } } } },
    "/v1/nft-analytics": { "post": { "summary": "NFT holdings summary for an EVM wallet", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["chain", "address"], "properties": { "chain": { "type": "string" }, "address": { "type": "string" } } } } } }, "responses": { "200": { "description": "Success" }, "422": { "$ref": "#/components/responses/ClientError" } } } }
  },
  "components": {
    "schemas": { "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } } },
    "responses": {
      "NotFound": { "description": "No data found for that address/protocol/symbol on this chain", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ClientError": { "description": "Bad input, or a live upstream failure with no cached fallback. Always 4xx, never 5xx.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
